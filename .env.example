# 数据库
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sse
DB_USER=sse
DB_PASSWORD=sse_dev

# JWT
JWT_SECRET=change-this-to-a-random-string-in-production

# 认证安全
# 历史明文密码登录开关：仅限迁移窗口临时使用，生产必须保持未设置或 0。
# 任何情况下 SCIM/MDM 写入的哨兵值（!、scim_managed_no_pwd、mdm_managed_no_pwd）都不能登录。
# ALLOW_LEGACY_PLAINTEXT_PASSWORDS=0
# bcrypt cost（自动限制在 10-14）
# BCRYPT_ROUNDS=10
# 反向代理层数；nginx 前置时设为 1。默认不信任 X-Forwarded-For，避免绕过登录限流。
# TRUST_PROXY=1
# SCIM / MDM Webhook 服务令牌（生产环境必填；未配置时生产返回 503 SERVICE_TOKEN_NOT_CONFIGURED）。
# 支持 Authorization: Bearer <token> 或 X-Service-Token: <token>。
# SCIM_TOKEN=
# MDM_TOKEN=
# WEBHOOK_TOKEN=

# MinIO 对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=invoices

# MCP API Key（Agent 调用用）
MCP_API_KEY=mcp_dev_key_001

# MCP HTTP transport（pnpm mcp:http）
# Streamable HTTP: /mcp | Legacy SSE: /sse + /messages | Health: /healthz
MCP_HTTP_PORT=3001
# MCP_LEGACY_SSE=1            # 设为 0 关闭旧 HTTP+SSE 兼容
# MCP_JSON_RESPONSE=0         # 设为 1 时 Streamable HTTP 直接用 JSON 响应
# MCP_CORS_ORIGIN=            # 设置后开启 CORS（浏览器客户端）
# MCP_MAX_SESSIONS=100
# MCP_MAX_BODY_BYTES=52428800 # 50MB，含 base64 发票等大请求体
# MCP_KEY_REFRESH_MS=60000    # DB 中 mcp_api_keys 的刷新周期（吊销/角色变更生效延迟）
# MCP_RATE_LIMIT_PER_MIN=120  # 每用户每分钟 MCP 工具调用上限
# MCP_AUDIT_LOG=1             # 设为 0 关闭工具调用审计（stderr JSON）
# MCP_SPARQL_MAX_RESULTS=1000 # SPARQL 结果硬上限

# MCP 工具委托 REST 时的 API 基址（审批/发票上传/核对）
# SSE_API_BASE=http://localhost:3000

# OpenAPI 文档里的 servers 地址（GET /openapi.json），也是内部 REST 调用的基址
# PUBLIC_API_BASE=http://localhost:3000

# 通知（开发环境用 console log，不需真实服务商）
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# 邮件 SMTP（EMAIL_PROVIDER=smtp 时必填）
# EMAIL_HOST=smtp.163.com
# EMAIL_PORT=465
# EMAIL_USER=your-email@163.com
# EMAIL_PASS=your-auth-code
# EMAIL_FROM=your-email@163.com

# 阿里云短信（SMS_PROVIDER=aliyun 时必填）
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_SMS_SIGN_NAME=审批通知

# 按事件配置模板 CODE（优先使用，未配置时回退到 ALIYUN_SMS_TEMPLATE_CODE）
# 提醒/升级/驳回/打款模板变量统一为 ${code}，值为报销单号
# ALIYUN_SMS_TEMPLATE_REMINDER=SMS_...
# ALIYUN_SMS_TEMPLATE_ESCALATION=SMS_...
# ALIYUN_SMS_TEMPLATE_REJECTED=SMS_...
# ALIYUN_SMS_TEMPLATE_PAID=SMS_...
# 广播模板建议为固定文案（无变量）
# ALIYUN_SMS_TEMPLATE_BROADCAST=SMS_...
# 通用回退模板
# ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# AI 模型（OCR识别 + 智能填单）
AI_ENDPOINT=http://localhost:11434/v1/chat/completions
AI_MODEL=llama3.2-vision

# MinerU API（云端文档解析，无需本地部署）
# 优先级：系统管理中已保存的 MinerU Token > 本文件的 MINERU_TOKEN。
# 在系统管理中点击「清除」后不再回落本文件；当前生效来源见 GET /admin/ai-config
# 的 ocrEngine.mineruTokenSource（saved / env / none）。
MINERU_TOKEN=

# 本体 v2（0=关闭、shadow=影子比对、on=启用）
ONTOLOGY_V2=0
ONTOLOGY_PROJECT_INTERVAL_MS=1000
ONTOLOGY_SNAPSHOT_INTERVAL_MS=5000
ONTOLOGY_SPARQL_TIMEOUT_MS=1500
ONTOLOGY_SPARQL_MAX_RESULTS=1000
ONTOLOGY_OUTBOX_RETENTION_DAYS=7
ONTOLOGY_ANOMALY_INTERVAL_MS=86400000
ONTOLOGY_MAX_OUTBOX_BATCH=200
ONTOLOGY_GRAPH_CALL_TIMEOUT_MS=30000
ONTOLOGY_SHADOW_INTERVAL_MS=300000
ONTOLOGY_SHADOW_SAMPLE_ROWS=200
# 可选：覆盖 Oxigraph worker 脚本路径（默认 dist/graph/oxigraph-worker.js）
# ONTOLOGY_WORKER_PATH=
