{
  "name": "sse",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web,mcp -c blue,green,magenta \"pnpm --filter @sse/api dev\" \"pnpm --filter @sse/web dev --host\" \"pnpm mcp\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "cd test && jest --verbose",
    "lint": "pnpm -r lint",
    "migrate": "pnpm --filter @sse/db migrate",
    "migrate:rollback": "pnpm --filter @sse/db migrate:rollback",
    "mcp": "pnpm --filter @sse/mcp build && node packages/mcp/dist/index.js",
    "mcp:http": "pnpm --filter @sse/mcp build && node packages/mcp/dist/http.js"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^9.2.1"
  }
}
